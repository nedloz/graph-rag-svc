# =========================
# Database (graph schema + read-only access to library.chunks)
# =========================
DATABASE_URL=postgresql+asyncpg://graph_user:graph_password@postgres:5432/app_db

# =========================
# LLM: все вызовы идут в llm-proxy (OpenAI-совместимый API). Провайдера, модель и ключ
# выбирает прокси (main/infra/llm-proxy); сервис шлёт model=default и ключ-заглушку.
# С mTLS-оверлеем: LLM_BASE_URL=https://llm-proxy:8443/v1
# =========================
LLM_BASE_URL=http://llm-proxy:8080/v1
LLM_MODEL=default
LLM_REQUEST_TIMEOUT_SEC=180
LLM_CONNECT_TIMEOUT_SEC=10

# Как часто сверять индекс базы знаний (BM25 по чанкам) с базой, секунды
INDEX_REFRESH_INTERVAL_SEC=60

# =========================
# GraphRAG (DISABLED: не работает, не вызывается). Ontology extraction.
# =========================
GRAPH_EXTRACTION_MODEL=
GRAPH_WINDOW_SIZE=4
GRAPH_WINDOW_STEP=3
ENTITY_SIMILARITY_THRESHOLD=0.86
GRAPH_TRAVERSAL_MAX_HOPS=2
MAX_CHUNKS_TO_USE=8

# =========================
# Internal connections
# =========================
CHAT_WS_URL=ws://chat-svc:8000/ws/internal/llm
EMBEDDING_SVC_URL=http://embedding-svc:8000

# Размерность векторов модели эмбеддингов (multilingual-e5-base — 768). Сверяется при запуске
# и с embedding-svc, и с фактическим типом колонки library.chunk_embeddings —
# при расхождении сервис не стартует. Смена модели = пересчёт чанков (README §13.1).
EMBEDDING_DIM=768
EMBEDDING_STARTUP_RETRIES=30
EMBEDDING_STARTUP_RETRY_WAIT_SEC=5

# =========================
# Service identity / internal auth
# =========================
SERVICE_NAME=graph-rag-svc

# Режим внутренней аутентификации: mtls (по умолчанию) — имя вызывающего берётся из X-Caller-Identity,
# который проставляет прокси-сайдкар (см. infra/mtls); insecure — без проверки, только для отладки.
INTERNAL_AUTH_MODE=mtls

# =========================
# Queue / concurrency
# =========================
LLM_HTTP_CONCURRENCY=1
MAX_QUEUE_SIZE=100

# =========================
# Пределы длины входа: длинный ввод обрезается (не отклоняется). Значения по умолчанию:
# =========================
# MAX_QUESTION_CHARS=4000
# MAX_HISTORY_MESSAGE_CHARS=4000
# MAX_HISTORY_CHARS=24000

# =========================
# Prompt injection policy: признаки в выбранных чанках всегда пишутся в лог;
# true — не отвечать на такой контекст (задание завершается ошибкой)
# =========================
FAIL_CLOSED_ON_INJECTION=false
