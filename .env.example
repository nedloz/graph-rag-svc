# =========================
# Database (graph schema + read-only access to library.chunks)
# =========================
DATABASE_URL=postgresql+asyncpg://graph_user:graph_password@postgres:5432/app_db

# =========================
# LLM provider (generation): openai | ollama | local | stub
# =========================
LLM_PROVIDER=ollama

# OpenAI — required only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama — required only when LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=mistral

# Local Transformers — required only when LLM_PROVIDER=local
TRANSFORMERS_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
DEVICE=cpu

# =========================
# Ontology extraction (triplet extraction — can use a smaller/cheaper model than generation)
# =========================
GRAPH_EXTRACTION_MODEL=
GRAPH_WINDOW_SIZE=4
GRAPH_WINDOW_STEP=3
ENTITY_SIMILARITY_THRESHOLD=0.86
GRAPH_TRAVERSAL_MAX_HOPS=2

# =========================
# Retrieval routing
# =========================
# always_graph | always_vector | heuristic
JUDGE_MODE=always_graph

# =========================
# Internal connections
# =========================
CHAT_WS_URL=ws://chat-svc:8000/ws/internal/llm
EMBEDDING_SVC_URL=http://embedding-svc:8000

# Размерность векторов модели эмбеддингов. Сверяется при запуске и с embedding-svc,
# и с фактическим типом колонок library.chunk_embeddings / graph.entities —
# при расхождении сервис не стартует. Смена модели = пересчёт чанков и графа (README §13.1).
EMBEDDING_DIM=1024
EMBEDDING_STARTUP_RETRIES=30
EMBEDDING_STARTUP_RETRY_WAIT_SEC=5

# =========================
# Service identity / internal auth
# =========================
SERVICE_NAME=graph-rag-svc
SERVICE_TOKEN=CHANGE_ME

INTERNAL_AUTH_ENABLED=true
TRUSTED_SERVICE_TOKENS={"chat-svc":"CHANGE_ME","db-svc":"CHANGE_ME"}
INTERNAL_AUTH_HEADER_NAME=X-Service-Token
INTERNAL_SERVICE_NAME_HEADER=X-Service-Name

# =========================
# Queue / concurrency
# =========================
LLM_HTTP_CONCURRENCY=1
MAX_QUEUE_SIZE=100

# =========================
# RAG context limits
# =========================
MAX_CHUNKS_TO_USE=8
MAX_CHUNK_CHARS=2500
MAX_CONTEXT_CHARS=12000
MAX_QUESTION_CHARS=4000

# Prompt injection policy
FAIL_CLOSED_ON_INJECTION=false
